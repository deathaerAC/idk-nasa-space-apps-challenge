      },
      {
        name: "McNeil et al. 2022: Mounds in Oxia Planum, JGR Planets",
        url: "https://oro.open.ac.uk/85891",
      },
      {
        name: "McNeil et al. 2025: Hydrated Silica in Oxia Planum, Mars, JGR Planets",
        url: "https://elib.dlr.de/217093/1/JGR%20Planets%20-%202025%20-%20McNeil%20-%20Hydrated%20Silica%20in%20Oxia%20Planum%20Mars.pdf",
      },
