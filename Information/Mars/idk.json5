  type DataSource = {
    url: string;
    name: string;
  }
  type Checklist = {
    name:string;
    terrainType:string[];
    // it seems there's not much info on temperature, sunlight, or radiation. I think we should drop them.
    temperature:number; // temperature in degrees celcius.
    // soil or regolith, grain size, dust, mineralogy
    surfaceMaterial:string[];
    // how much, and how it changes over time
    sunlight: string[];
    radiation: string[];
    // e.g. water ice, usable minerals
    resources: string[];
    interestingBits:string[]
    hazards: string[];
    dataSources:DataSource[];
  }
*/
[
  {
    name: "Meridiani Planum",
    terrainType: [
      "Very flat, low-relief plain (about 1.4 km below the Mars datum) near the equator. ",
      "Layered sulfate-rich sedimentary bedrock lies under a thin cover of wind-blown sand, ",
      "with sparse small impact craters and wind ripples."
    ],

    // Approximate: equatorial surface air temperatures swing from roughly -100 °C
    // (pre-dawn) to about 0 °C (midday); the annual mean is about -60 °C.
    temperature: -60,

    surfaceMaterial: [
      "Soils are fine-grained basaltic sand mixed with dust and sulfate-rich debris from the bedrock, ",
      "poorly sorted and shaped into wind ripples. The ripples are armored with a lag of ",
      "granule-sized hematite-rich spherules (concretions) weathered out of the bedrock. ",
      "The soil layer is thin, about 1 m on the plains. ",
      "Mineralogy: pyroxene, plagioclase, olivine, crystalline hematite, ",
      "nanophase iron-oxide dust, and Mg/Ca/Fe sulfates (including jarosite) in the bedrock.",
    ],
    sunlight: [
      "Equatorial site (about 2° S), so day length stays near 12 h and the Sun is high all year, ",
      "with little seasonal swing in solar energy. Available light is controlled mainly by ",
      "atmospheric dust: opacity rises in the dusty southern-spring/summer season and during ",
      "regional or global dust storms (e.g. 2007, 2018), when sunlight can drop sharply for weeks. ",
      "Dust settling on solar panels reduces power between wind-cleaning events."
    ],

    radiation: [
      "No global magnetic field and a thin atmosphere, so the surface gets galactic cosmic rays ",
      "plus occasional solar particle events. The low elevation gives slightly more atmospheric ",
      "shielding than highlands sites. Expect a dose on the order of 0.5-0.7 mSv/day, ",
      "similar to the MSL/Curiosity measurements at Gale crater. This figure is approximate.",
    ],
    resources: [
      "Hydrated sulfate minerals (Mg/Ca/Fe sulfates, jarosite): a possible source of bound water",
      "Hematite concretions: a ready-made iron-oxide source, already concentrated at the surface",
      "Basaltic sand and regolith: construction material, radiation shielding, ISRU feedstock",
      "Olivine and pyroxene: silicate/metal feedstock",
      "Flat, rock-poor terrain: easy landing, roads and pad construction",
      // No confirmed surface water ice here; at the equator ice is only possibly stable at depth.
    ],

    interestingBits: [
      "Opportunity found strong evidence of past liquid water, including cross-bedding, ripple structures, and chemistry consistent with acidic, saline groundwater and shallow surface water",
      "Hematite-rich 'blueberry' concretions are widespread and are interpreted as having formed in groundwater",
      "Orbital spectrometers (e.g. MGS TES) detected a large gray crystalline hematite deposit, a key reason the site was selected",
      "Layered stratigraphy exposed in Eagle, Endurance and Victoria craters records a sequence of wet-to-dry environmental change",
      "Opportunity found an iron meteorite ('Heat Shield Rock', later named Meridiani Planum meteorite) and other meteorites on the plain",
      "Later in the mission Opportunity explored Endeavour Crater's rim, finding clay minerals and gypsum veins indicating less acidic water",
      "The flat, smooth terrain makes it an unusually safe landing and driving environment"
      ],

    hazards: [
      "Dust storms: reduced sunlight and power, plus airborne dust",
      "Dust on panels and mechanisms: abrasion, electrostatic cling, reduced solar output",
      "Soft sand ripples: Opportunity was stuck in Purgatory Dune for about 5 weeks in 2005",
      "Acidic, sulfate- and salt-rich soils and groundwater history: corrosion and toxicity concerns",
      "Large day/night temperature swings: thermal cycling stress on hardware",
      "Cosmic-ray and solar-particle radiation with no magnetic shielding",
      "No confirmed accessible surface water ice, so water needs to be extracted from minerals",
    ],

    dataSources: [
      {
        name: "Arvidson, R. E., et al. (2011), Opportunity Mars Rover mission: Overview and selected results from Purgatory ripple to traverses to Endeavour crater, J. Geophys. Res., 116, E00F15, doi:10.1029/2010JE003746.",
        url: "https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2010JE003746",
      },
      {
        name: "Arvidson et al. 2006, Nature and origin of the hematite-bearing plains of Terra Meridiani (JGR)",
        url: "https://pubs.usgs.gov/publication/70028845",
      },
      {
        name: "USGS Astrogeology, Soils of Eagle Crater and Meridiani Planum at the Opportunity landing site",
        url: "https://webarchive.library.unt.edu/eot2008/20081107052053/http://astrogeology.usgs.gov/Research/Publications/AAAS-Science/Vol306Page1723.html",
      },
      {
        name: "Squyres et al. 2006, Two Years at Meridiani Planum: Results from the Opportunity Rover",
        url: "https://typeset.io/pdf/two-years-at-meridiani-planum-results-from-the-opportunity-538jp73siz.pdf",
      },
